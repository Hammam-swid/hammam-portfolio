# Server
PORT=4000
NODE_ENV=development
# Public URL of this API (used in logs / docs)
PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed browser origins (portfolio + admin)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=portfolio
DB_PASSWORD=change-me
DB_NAME=portfolio

# Auth — generate the hash with: npm run hash-password -- "your password"
JWT_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Uploads — keep this OUTSIDE the app folder on the server so redeploys don't delete it
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100
